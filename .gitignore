# Python
__pycache__/
*.py[cod]
*.pyo
.env
*.egg-info/
dist/
build/
.venv/
venv/
env/

# macOS
.DS_Store

# IDE
.vscode/
.idea/

# Logs
*.log

# 手動備份檔（git 本身即備份，勿進版控）
*.bak

# 前端 JS bundle 為衍生物（main.py 的 _build_js_bundle() 在 import 時自動重建）
frontend/static/js/app.bundle.js

# Pionex 標的清單執行期快取（勿進版控）
backend/data/.pionex_syms_cache.json

# DataFrame 磁碟快取（執行期、勿進版控）
backend/.df_cache/

# 執行期快取（足跡每日成交 CSV 聚合、雷達 log 等，勿進版控）
backend/cache/

# 帳號 SQLite（本機開發用）
backend/.accounts.db
frontend/static/css/style.min.css
# 動態載入 JS 的壓縮產物：開機時 _build_fx_min() 產生。⚠ 不可進版控 ——
# 它用「產物 mtime ≥ 原始碼」判斷要不要重建，git 取出時兩者同時間 → 會沿用版控裡的舊產物。
frontend/static/js/*.min.js
.venv312/

# 帳號備份（含真實使用者資料，絕不進版控）
backend/.qwer_*_backup.json
backend/.*_backup.json
# 帳號快照/還原前備份（檔名不一定帶 _backup）
backend/.qwer_*.json
# 靜態檔預壓產物（main.py _precompress_br 開機時生成）
frontend/static/**/*.br
